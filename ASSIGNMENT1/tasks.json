{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Graphics File (g++)",
            "command": "C:\\Users\\aditi\\w64devkit\\bin\\g++.exe",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-lbgi",
                "-lgdi32",
                "-lcomdlg32",
                "-luuid",
                "-loleaut32",
                "-lole32"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "C:\\Users\\aditi\\w64devkit\\bin;${env:PATH}"
                }
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compile active C/C++ file with graphics.h (WinBGIm) flags"
        },
        {
            "type": "shell",
            "label": "Build and Run Graphics Project",
            "command": "C:\\Users\\aditi\\w64devkit\\bin\\g++.exe -g \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\" -lbgi -lgdi32 -lcomdlg32 -luuid -loleaut32 -lole32 && \"${fileDirname}\\${fileBasenameNoExtension}.exe\"",
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "C:\\Users\\aditi\\w64devkit\\bin;${env:PATH}"
                }
            },
            "problemMatcher": ["$gcc"],
            "group": "test",
            "detail": "Build the active graphics file and immediately run the executable"
        }
    ]
}
